# PicoAide native systemd EnvironmentFile example (intranet HTTP).
# Copy to /opt/picoaide/server.env, replace every change-me-* value, chmod 640.
# Passwords MUST stay in this file — never put them on the ExecStart command line.

# PostgreSQL DSN (read by picoaide-server when -pg-dsn is empty)
PICOAI_PG_DSN=postgres://picoaide:change-me-pg-password@127.0.0.1:5432/picoaide?sslmode=disable

# Bootstrap admin password (first start only; clear after admin exists)
PICOAI_ADMIN_PASSWORD=change-me-admin-password

# Layout knobs (defaults match install.sh under /opt/picoaide)
PICOAI_CHANNEL_DIR=/opt/picoaide/channel
PICOAI_CLIENT_RELEASE_DIR=/opt/picoaide/client
PICOAI_SKILL_SEED_DIR=/opt/picoaide/skills

# Optional channel id override (leave empty to use image/CHANNEL file semantics)
# PICOAI_CHANNEL=your-channel-id

# WASM compile isolation: require | auto | off  (install bubblewrap/bwrap for require/auto)
PICOAI_COMPILE_ISOLATION=auto

# Optional memory profile on small hosts: default | small | large
# PICOAI_WASM_MEMORY_PROFILE=small
